{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/astro-nova build",
  "outputDirectory": "artifacts/astro-nova/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
